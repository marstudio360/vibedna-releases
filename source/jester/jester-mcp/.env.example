# JesterDNA: environment template
# Copy this to .env and fill in your keys. Without MCPIZE_LICENSE_KEY, Jester runs its free tier.

# JesterDNA Pro license key. It starts with vbd_, arrives in your purchase email,
# and is also in your library at https://vibedna.ai/library
MCPIZE_LICENSE_KEY=

# OPTIONAL: only if you want autonomous synthesis (synthesize=True).
# Most users leave this blank and let Claude in their chat do the synthesis.
ANTHROPIC_API_KEY=

# OPTIONAL: unlocks Exa neural search (free tier at exa.ai)
EXA_API_KEY=

# OPTIONAL: unlocks Firecrawl deep page crawl (free tier at firecrawl.dev)
FIRECRAWL_API_KEY=

# OPTIONAL: unlocks podcast episode search (free tier at listennotes.com)
LISTENNOTES_API_KEY=

# OPTIONAL: set to 0 to skip downloading the Whisper model (~75MB)
# Captions still work for 99% of YouTube videos; only caption-less fallback breaks
JESTER_WHISPER_MAX_SECONDS=1800
